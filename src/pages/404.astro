---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Page Not Found - Real Playback Speed" description="The page you are looking for does not exist. Return to the playback speed calculator.">
  <section class="section-container" style="padding: var(--spacing-3xl) var(--spacing-lg); max-width: 600px; margin: 0 auto; text-align: center;">
    <div style="font-size: 96px; font-weight: 800; color: var(--color-mute); line-height: 1; margin-bottom: var(--spacing-md);">404</div>
    <h1 style="font-size: var(--font-size-heading-xl); font-weight: var(--font-weight-heading-xl); color: var(--color-ink); margin: 0 0 var(--spacing-md);">Page Not Found</h1>
    <p style="font-size: var(--font-size-body-md); color: var(--color-body); line-height: var(--line-height-body-md); margin-bottom: var(--spacing-lg);">
      Sorry, we couldn't find the page you're looking for. It may have been moved or deleted.
    </p>
    <div style="display: flex; gap: var(--spacing-sm); justify-content: center; flex-wrap: wrap;">
      <a href="/" class="btn-primary" style="text-decoration: none;">Go to Calculator</a>
      <a href="/about" class="btn-ghost" style="text-decoration: none;">About Us</a>
      <a href="/contact" class="btn-ghost" style="text-decoration: none;">Contact Us</a>
    </div>
  </section>
</PageLayout>
