---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Features — Playback speed Calculator" description="Real-time calculations, keyboard shortcuts, and a clean interface." lang="en" device="desktop">
  <section style="padding: var(--spacing-3xl) var(--spacing-lg); background-color: var(--color-canvas);">
    <div class="section-container">
      <div style="text-align: center; margin-bottom: var(--spacing-3xl);">
        <div class="eyebrow" style="margin-bottom: var(--spacing-md);">FEATURES</div>
        <h1 style="font-size: var(--font-size-heading-lg); font-weight: var(--font-weight-heading-lg); line-height: var(--line-height-heading-lg); letter-spacing: var(--letter-spacing-heading-lg); color: var(--color-ink); margin: 0 0 var(--spacing-md);" data-i18n="features.title">Built for speed</h1>
        <p style="font-size: var(--font-size-body-lg); color: var(--color-body); max-width: 600px; margin: 0 auto;" data-i18n="features.desc">Real-time calculations, keyboard shortcuts, and a clean interface that gets out of your way.</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--spacing-lg);">
        <div class="card">
          <div style="font-size: 24px; margin-bottom: var(--spacing-sm);">⚡</div>
          <h3 style="font-size: var(--font-size-heading-md); font-weight: var(--font-weight-heading-md); color: var(--color-ink); margin: 0 0 var(--spacing-xs);" data-i18n="features.real-time">Real-time Updates</h3>
          <p style="font-size: var(--font-size-body-md); color: var(--color-body); margin: 0;" data-i18n="features.real-time-desc">Results update instantly as you type. No "Calculate" button needed.</p>
        </div>
        <div class="card">
          <div style="font-size: 24px; margin-bottom: var(--spacing-sm);">🎯</div>
          <h3 style="font-size: var(--font-size-heading-md); font-weight: var(--font-weight-heading-md); color: var(--color-ink); margin: 0 0 var(--spacing-xs);" data-i18n="features.target-time">Target Time Reverse</h3>
          <p style="font-size: var(--font-size-body-md); color: var(--color-body); margin: 0;" data-i18n="features.target-time-desc">Enter your available time and find the exact speed needed to finish on time.</p>
        </div>
        <div class="card">
          <div style="font-size: 24px; margin-bottom: var(--spacing-sm);">📋</div>
          <h3 style="font-size: var(--font-size-heading-md); font-weight: var(--font-weight-heading-md); color: var(--color-ink); margin: 0 0 var(--spacing-xs);" data-i18n="features.playlist">Playlist Batch</h3>
          <p style="font-size: var(--font-size-body-md); color: var(--color-body); margin: 0;" data-i18n="features.playlist-desc">Add multiple videos, episodes, or chapters for combined calculations.</p>
        </div>
        <div class="card">
          <div style="font-size: 24px; margin-bottom: var(--spacing-sm);">⌨️</div>
          <h3 style="font-size: var(--font-size-heading-md); font-weight: var(--font-weight-heading-md); color: var(--color-ink); margin: 0 0 var(--spacing-xs);" data-i18n="features.keyboard">Keyboard Shortcuts</h3>
          <p style="font-size: var(--font-size-body-md); color: var(--color-body); margin: 0;" data-i18n="features.keyboard-desc">Numbers 1-8 for presets, C to copy, S to share, R to reset.</p>
        </div>
        <div class="card">
          <div style="font-size: 24px; margin-bottom: var(--spacing-sm);">📱</div>
          <h3 style="font-size: var(--font-size-heading-md); font-weight: var(--font-weight-heading-md); color: var(--color-ink); margin: 0 0 var(--spacing-xs);" data-i18n="features.mobile">Mobile Friendly</h3>
          <p style="font-size: var(--font-size-body-md); color: var(--color-body); margin: 0;" data-i18n="features.mobile-desc">Responsive design that works seamlessly on any device.</p>
        </div>
        <div class="card">
          <div style="font-size: 24px; margin-bottom: var(--spacing-sm);">🔗</div>
          <h3 style="font-size: var(--font-size-heading-md); font-weight: var(--font-weight-heading-md); color: var(--color-ink); margin: 0 0 var(--spacing-xs);" data-i18n="features.share">Share Results</h3>
          <p style="font-size: var(--font-size-body-md); color: var(--color-body); margin: 0;" data-i18n="features.share-desc">One-click copy and shareable URLs with your calculations.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
