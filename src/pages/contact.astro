---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Contact Us - Real Playback Speed" description="Contact Real Playback Speed. Get in touch with the playback speed calculator team.">
  <section class="section-container" style="padding: var(--spacing-3xl) var(--spacing-lg); max-width: 800px; margin: 0 auto;">
    <div style="margin-bottom: var(--spacing-xs); text-transform: uppercase; letter-spacing: 1px; font-size: var(--font-size-body-sm); font-weight: 600; color: var(--color-link);">Contact Us</div>
    <h1 style="font-size: var(--font-size-heading-xl); font-weight: var(--font-weight-heading-xl); color: var(--color-ink); margin: 0 0 var(--spacing-lg);">Contact Real Playback Speed</h1>
    <p style="font-size: var(--font-size-body-md); color: var(--color-body); line-height: var(--line-height-body-md); margin-bottom: var(--spacing-md);">
      Have feedback, a feature request, or a question about the playback speed calculator? Reach out to us.
    </p>

    <form id="contact-form" style="background-color: var(--color-canvas-elevated); padding: var(--spacing-lg); border-radius: var(--radius-md); border: 1px solid var(--color-hairline); display: grid; gap: var(--spacing-md); max-width: 560px; margin-bottom: var(--spacing-lg);">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-md);">
        <div>
          <label for="contact-name" style="display: block; font-size: var(--font-size-body-sm); font-weight: 600; color: var(--color-ink); margin-bottom: var(--spacing-xs);">Name</label>
          <input type="text" id="contact-name" name="name" required minlength="2" placeholder="Your name" style="width: 100%; padding: var(--spacing-sm) var(--spacing-md); border: 1px solid var(--color-hairline); border-radius: var(--radius-sm); background: var(--color-canvas); color: var(--color-ink); font-size: var(--font-size-body-md);" />
        </div>
        <div>
          <label for="contact-email" style="display: block; font-size: var(--font-size-body-sm); font-weight: 600; color: var(--color-ink); margin-bottom: var(--spacing-xs);">Email</label>
          <input type="email" id="contact-email" name="email" required placeholder="you@example.com" style="width: 100%; padding: var(--spacing-sm) var(--spacing-md); border: 1px solid var(--color-hairline); border-radius: var(--radius-sm); background: var(--color-canvas); color: var(--color-ink); font-size: var(--font-size-body-md);" />
        </div>
      </div>
      <div>
        <label for="contact-topic" style="display: block; font-size: var(--font-size-body-sm); font-weight: 600; color: var(--color-ink); margin-bottom: var(--spacing-xs);">Topic</label>
        <select id="contact-topic" name="topic" style="width: 100%; padding: var(--spacing-sm) var(--spacing-md); border: 1px solid var(--color-hairline); border-radius: var(--radius-sm); background: var(--color-canvas); color: var(--color-ink); font-size: var(--font-size-body-md);">
          <option value="general">General inquiry</option>
          <option value="feedback">Feedback</option>
          <option value="feature">Feature request</option>
          <option value="bug">Bug report</option>
          <option value="partnership">Partnership</option>
          <option value="other">Other</option>
        </select>
      </div>
      <div>
        <label for="contact-message" style="display: block; font-size: var(--font-size-body-sm); font-weight: 600; color: var(--color-ink); margin-bottom: var(--spacing-xs);">Message</label>
        <textarea id="contact-message" name="message" required minlength="10" rows="5" placeholder="How can we help?" style="width: 100%; padding: var(--spacing-sm) var(--spacing-md); border: 1px solid var(--color-hairline); border-radius: var(--radius-sm); background: var(--color-canvas); color: var(--color-ink); font-size: var(--font-size-body-md); font-family: inherit;"></textarea>
      </div>
      <button type="submit" id="contact-submit" class="btn-primary" style="text-decoration: none; width: fit-content; justify-self: start;">Send Message</button>
    </form>
    <div id="contact-result" style="min-height: 1.5rem; font-size: var(--font-size-body-sm); color: var(--color-success-deep);"></div>

    <h2 style="font-size: var(--font-size-heading-md); font-weight: var(--font-weight-heading-md); color: var(--color-ink); margin: var(--spacing-lg) 0 var(--spacing-sm);">Other Ways to Reach Us</h2>
    <div style="background-color: var(--color-canvas-elevated); padding: var(--spacing-lg); border-radius: var(--radius-md); border: 1px solid var(--color-hairline);">
      <p style="font-size: var(--font-size-body-md); color: var(--color-body); line-height: var(--line-height-body-md); margin-bottom: var(--spacing-md);">
        Email: <a href="mailto:support@realplaybackspeed.com" style="color: var(--color-link); word-break: break-all;">support@realplaybackspeed.com</a>
      </p>
      <p style="font-size: var(--font-size-body-md); color: var(--color-body); line-height: var(--line-height-body-md); margin-bottom: var(--spacing-sm);">
        Website: <a href="/" style="color: var(--color-link);">realplaybackspeed.com</a>
      </p>
    </div>
    <p style="font-size: var(--font-size-body-md); color: var(--color-body); line-height: var(--line-height-body-md); margin-bottom: var(--spacing-md);">
      We read every message and use your suggestions to improve the calculator. Also see our
      <a href="/privacy-policy" style="color: var(--color-link);">Privacy Policy</a> and
      <a href="/terms" style="color: var(--color-link);">Terms and Conditions</a>.
    </p>
    <p style="font-size: var(--font-size-body-md); color: var(--color-body); line-height: var(--line-height-body-md); margin-bottom: var(--spacing-md);">
      Ready to calculate? Go to the <a href="/" style="color: var(--color-link);">Playback Speed Calculator</a>.
    </p>
  </section>

  <script is:inline>
    (function() {
      var form = document.getElementById('contact-form');
      var result = document.getElementById('contact-result');
      var submit = document.getElementById('contact-submit');
      if (!form) return;
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var name = form.elements.namedItem('name').value.trim();
        var email = form.elements.namedItem('email').value.trim();
        var topic = form.elements.namedItem('topic').value;
        var message = form.elements.namedItem('message').value.trim();
        if (!name || !email || !message) {
          result.textContent = 'Please fill in all required fields.';
          result.style.color = 'var(--color-warning-deep)';
          return;
        }
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          result.textContent = 'Please enter a valid email address.';
          result.style.color = 'var(--color-warning-deep)';
          return;
        }
        submit.disabled = true;
        submit.textContent = 'Sending…';
        result.textContent = '';
        // Demo: simulate sending; replace with real endpoint as needed
        setTimeout(function() {
          result.textContent = 'Thanks ' + name + '! Your message (' + topic + ') has been sent.';
          result.style.color = 'var(--color-success-deep)';
          form.reset();
          submit.disabled = false;
          submit.textContent = 'Send Message';
        }, 1200);
      });
    })();
  </script>
</PageLayout>
