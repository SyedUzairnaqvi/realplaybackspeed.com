  <!-- FAQ: Playback Speed Calculator -->
  <section id="playback-speed-faq" class="section-container" style="padding: var(--spacing-3xl) var(--spacing-lg); background-color: var(--color-canvas-elevated); max-width: 1000px; margin: 0 auto;">
    <div class="eyebrow" style="margin-bottom: var(--spacing-xs); text-transform: uppercase; letter-spacing: 1px; font-size: var(--font-size-body-sm); font-weight: 600; color: var(--color-link);">अक्सर पूछे जाने वाले प्रश्न</div>
    <h2 style="font-size: var(--font-size-heading-xl); font-weight: var(--font-weight-heading-xl); line-height: var(--line-height-heading-xl); color: var(--color-ink); margin: 0 0 var(--spacing-lg); text-align: center;">अक्सर पूछे जाने वाले प्रश्न</h2>

    <details class="faq-item" style="border: 1px solid var(--color-hairline); border-radius: var(--radius-md); margin-bottom: var(--spacing-sm); overflow: hidden;">
      <summary style="padding: var(--spacing-md) var(--spacing-lg); font-weight: 600; font-size: var(--font-size-body-md); color: var(--color-ink); cursor: pointer; list-style: none; outline: none;">
        प्लेबैक स्पीड क्या है?
      </summary>
      <div style="padding: 0 var(--spacing-lg) var(--spacing-lg); font-size: var(--font-size-body-md); color: var(--color-body); line-height: var(--line-height-body-md);">
        प्लेबैक स्पीड वह दर है जिस पर मीडिया अपनी मूल रिकॉर्डिंग के सापेक्ष चलता है। 1.0x पर, कंटेंट सामान्य गति से चलता है। 1.5x पर, 60 मिनट का वीडियो 40 मिनट में समाप्त होता है; 2.0x पर, यह 30 मिनट में समाप्त होता है।
      </div>
    </details>

    <details class="faq-item" style="border: 1px solid var(--color-hairline); border-radius: var(--radius-md); margin-bottom: var(--spacing-sm); overflow: hidden;">
      <summary style="padding: var(--spacing-md) var(--spacing-lg); font-weight: 600; font-size: var(--font-size-body-md); color: var(--color-ink); cursor: pointer; list-style: none; outline: none;">
        1.5x प्लेबैक स्पीड कितनी तेज़ है?
      </summary>
      <div style="padding: 0 var(--spacing-lg) var(--spacing-lg); font-size: var(--font-size-body-md); color: var(--color-body); line-height: var(--line-height-body-md);">
        1.5x पर, कंटेंट सामान्य से 50% तेज़ चलता है। 60 मिनट का वीडियो 40 मिनट लेता है, 30 मिनट का वीडियो 20 मिनट लेता है, और 90 मिनट का वीडियो 60 मिनट लेता है।
      </div>
    </details>

    <details class="faq-item" style="border: 1px solid var(--color-hairline); border-radius: var(--radius-md); margin-bottom: var(--spacing-sm); overflow: hidden;">
      <summary style="padding: var(--spacing-md) var(--spacing-lg); font-weight: 600; font-size: var(--font-size-body-md); color: var(--color-ink); cursor: pointer; list-style: none; outline: none;">
        अलग स्पीड पर बचा समय कैसे कैलकुलेट करें?
      </summary>
      <div style="padding: 0 var(--spacing-lg) var(--spacing-lg); font-size: var(--font-size-body-md); color: var(--color-body); line-height: var(--line-height-body-md);">
        मूल अवधि को प्लेबैक स्पीड से विभाजित करें। उदाहरण के लिए, 60 मिनट को 1.5 से विभाजित करने पर 40 मिनट होता है। बचा समय मूल अवधि घटा समायोजित अवधि है — इस मामले में, 20 मिनट बचे।
      </div>
    </details>

    <details class="faq-item" style="border: 1px solid var(--color-hairline); border-radius: var(--radius-md); margin-bottom: var(--spacing-sm); overflow: hidden;">
      <summary style="padding: var(--spacing-md) var(--spacing-lg); font-weight: 600; font-size: var(--font-size-body-md); color: var(--color-ink); cursor: pointer; list-style: none; outline: none;">
        सामान्य प्लेबैक स्पीड कौन सी है?
      </summary>
      <div style="padding: 0 var(--spacing-lg) var(--spacing-lg); font-size: var(--font-size-body-md); color: var(--color-body); line-height: var(--line-height-body-md);">
        सामान्य प्लेबैक स्पीड 1.0x है — मूल रिकॉर्डिंग स्पीड बिना किसी तेज़ी या धीमेपन के।
      </div>
    </details>

    <details class="faq-item" style="border: 1px solid var(--color-hairline); border-radius: var(--radius-md); margin-bottom: var(--spacing-sm); overflow: hidden;">
      <summary style="padding: var(--spacing-md) var(--spacing-lg); font-weight: 600; font-size: var(--font-size-body-md); color: var(--color-ink); cursor: pointer; list-style: none; outline: none;">
        समय सीमा के भीतर खत्म करने के लिए आवश्यक स्पीड कैसे खोजें?
      </summary>
      <div style="padding: 0 var(--spacing-lg) var(--spacing-lg); font-size: var(--font-size-body-md); color: var(--color-body); line-height: var(--line-height-body-md);">
        मूल अवधि को अपने टारगेट समय से विभाजित करें। एक 90 मिनट का वीडियो जिसे आप 45 मिनट में खत्म करना चाहते हैं, उसे 90 ÷ 45 = 2.0x की आवश्यकता है। इसे स्वचालित रूप से कैलकुलेट करने के लिए टारगेट टाइम मोड का उपयोग करें।
      </div>
    </details>

    <details class="faq-item" style="border: 1px solid var(--color-hairline); border-radius: var(--radius-md); margin-bottom: var(--spacing-sm); overflow: hidden;">
      <summary style="padding: var(--spacing-md) var(--spacing-lg); font-weight: 600; font-size: var(--font-size-body-md); color: var(--color-ink); cursor: pointer; list-style: none; outline: none;">
        क्या प्लेबैक स्पीड देखने के समय को प्रभावित करती है?
      </summary>
      <div style="padding: 0 var(--spacing-lg) var(--spacing-lg); font-size: var(--font-size-body-md); color: var(--color-body); line-height: var(--line-height-body-md);">
        हां। तेज़ स्पीड पर देखने से कुल देखने का समय कम हो जाता है क्योंकि वही कंटेंट कम समय में चलता है। 1.5x पर 60 मिनट का वीडियो 40 मिनट के देखने के समय में परिणत होता है।
      </div>
    </details>

    <details class="faq-item" style="border: 1px solid var(--color-hairline); border-radius: var(--radius-md); margin-bottom: var(--spacing-sm); overflow: hidden;">
      <summary style="padding: var(--spacing-md) var(--spacing-lg); font-weight: 600; font-size: var(--font-size-body-md); color: var(--color-ink); cursor: pointer; list-style: none; outline: none;">
        1.5x स्पीड पर 1 घंटा कितना होता है?
      </summary>
      <div style="padding: 0 var(--spacing-lg) var(--spacing-lg); font-size: var(--font-size-body-md); color: var(--color-body); line-height: var(--line-height-body-md);">
        1.5x प्लेबैक स्पीड पर एक घंटा 40 मिनट लेता है। आप 20 मिनट बचाते हैं। 60 मिनट ÷ 1.5 = 40 मिनट।
      </div>
    </details>

    <details class="faq-item" style="border: 1px solid var(--color-hairline); border-radius: var(--radius-md); margin-bottom: var(--spacing-sm); overflow: hidden;">
      <summary style="padding: var(--spacing-md) var(--spacing-lg); font-weight: 600; font-size: var(--font-size-body-md); color: var(--color-ink); cursor: pointer; list-style: none; outline: none;">
        क्या मैं एक साथ कई वीडियो कैलकुलेट कर सकता हूँ?
      </summary>
      <div style="padding: 0 var(--spacing-lg) var(--spacing-lg); font-size: var(--font-size-body-md); color: var(--color-body); line-height: var(--line-height-body-md);">
        हां। प्लेलिस्ट बैच मोड आपको कई वीडियो अवधि दर्ज करने देता है और आपकी चुनी गई स्पीड पर उन सभी में कुल समायोजित समय और बचा समय दिखाता है।
      </div>
    </details>

    <details class="faq-item" style="border: 1px solid var(--color-hairline); border-radius: var(--radius-md); margin-bottom: var(--spacing-sm); overflow: hidden;">
      <summary style="padding: var(--spacing-md) var(--spacing-lg); font-weight: 600; font-size: var(--font-size-body-md); color: var(--color-ink); cursor: pointer; list-style: none; outline: none;">
        प्लेबैक स्पीड बढ़ाने का शॉर्टकट?
      </summary>
      <div style="padding: 0 var(--spacing-lg) var(--spacing-lg); font-size: var(--font-size-body-md); color: var(--color-body); line-height: var(--line-height-body-md);">
        वेब ब्राउज़र में YouTube पर, Shift दबाए रखें और स्पीड बढ़ाने के लिए ग्रेटर-थान की दबाएं, या घटाने के लिए Shift और कॉमा दबाएं। हमारी साइट कीबोर्ड शॉर्टकट सपोर्ट करती है: प्रीसेट स्पीड के लिए 1–8 दबाएं, कॉपी के लिए C, रीसेट के लिए R, और मोड बदलने के लिए Tab।
      </div>
    </details>
