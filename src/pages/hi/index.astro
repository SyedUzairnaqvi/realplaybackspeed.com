---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="प्लेबैक स्पीड कैलकुलेटर - मुफ्त ऑनलाइन प्लेबैक स्पीड टूल" description="ऑनलाइन प्लेबैक स्पीड की गणना करें। YouTube, Netflix, Spotify, ऑडियोबुक, और वीडियो के लिए मुफ्त प्लेबैक स्पीड कैलकुलेटर। तुरंत देखने का समय, बचा हुआ समय, और आवश्यक गति खोजें।" lang="hi" canonical="https://realplaybackspeed.com/hi/" ogImage="/favicon-96x96.png">
  <!-- Skip Link -->
  <a href="#calculator" style="position: absolute; left: -9999px; z-index: 999; padding: 8px 16px; background: var(--color-ink); color: var(--color-on-primary); text-decoration: none; border-radius: var(--radius-sm);" on:focus="this.style.left='8px'; this.style.top='8px';" on:blur="this.style.left='-9999px';">कैलकुलेटर पर जाएं</a>
  
  <!-- Hero Section -->
  <section class="hero-band">
    <div class="section-container hero-content" style="text-align: center; position: relative; z-index: 1;">
      <div class="eyebrow hero-eyebrow" data-i18n="hero.eyebrow" style="margin-bottom: var(--spacing-xs);">गणना करें</div>
      <h1 class="hero-title" data-i18n="hero.title" style="font-size: var(--font-size-display-xl); font-weight: var(--font-weight-display-xl); line-height: var(--line-height-display-xl); letter-spacing: var(--letter-spacing-display-xl); color: var(--color-ink); margin: 0 0 var(--spacing-md);">
        प्लेबैक स्पीड कैलकुलेटर
      </h1>
      <p class="hero-desc" data-i18n="hero.desc" style="font-size: var(--font-size-body-lg); line-height: var(--line-height-body-lg); color: var(--color-body); max-width: 600px; margin: 0 auto var(--spacing-xl);">
        रियल टाइम में सटीक देखने या सुनने की अवधि, बचा हुआ समय, और आवश्यक गति की गणना करें। 
        "कैलकुलेट" बटन की आवश्यकता नहीं — टाइप करते ही परिणाम अपडेट होते हैं।
      </p>
      <div style="display: flex; gap: var(--spacing-sm); justify-content: center; flex-wrap: wrap;">
        <a href="#calculator" class="btn-primary" data-i18n="hero.cta-calc" style="text-decoration: none;">गणना शुरू करें</a>
        <a href="/hi/features" class="btn-secondary" data-i18n="hero.cta-features" style="text-decoration: none;">विशेषताएं देखें</a>
      </div>

      <!-- Choose file upload (local video duration auto-detect) -->
      <div style="margin-top: var(--spacing-xl); display: flex; flex-direction: column; align-items: center; gap: var(--spacing-sm);">
        <label for="hero-file-input" style="display: inline-flex; align-items: center; gap: var(--spacing-xs); cursor: pointer; font-size: var(--font-size-body-md); color: var(--color-body);">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
          फ़ाइल चुनें
        </label>
        <input type="file" id="hero-file-input" accept="video/*" style="display: none;" />
        <div id="hero-file-status" style="font-size: var(--font-size-body-sm); color: var(--color-mute); min-height: 1.25rem;"></div>
      </div>
    </div>
  </section>

  <!-- Calculator Section -->
  <section id="calculator" class="calculator-section" style="padding: var(--spacing-3xl) var(--spacing-lg); background-color: var(--color-canvas-elevated);">
    <div class="section-container">
      <!-- Mode Tabs -->
      <div class="mode-tabs" role="tablist" aria-label="Calculator modes">
        <button role="tab" aria-selected="true" aria-controls="panel-standard" id="tab-standard" class="mode-tab active" data-mode="standard">
          <span class="hidden sm:inline" data-i18n="calculator.tab-standard">स्पीड कैलकुलेटर</span>
          <span class="sm:hidden" data-i18n="calculator.tab-standard-short">स्पीड</span>
        </button>
        <button role="tab" aria-selected="false" aria-controls="panel-reverse" id="tab-reverse" class="mode-tab" data-mode="reverse">
          <span class="hidden sm:inline" data-i18n="calculator.tab-reverse">टारगेट टाइम</span>
          <span class="sm:hidden" data-i18n="calculator.tab-reverse-short">टारगेट</span>
        </button>
        <button role="tab" aria-selected="false" aria-controls="panel-batch" id="tab-batch" class="mode-tab" data-mode="batch">
          <span class="hidden sm:inline" data-i18n="calculator.tab-batch">प्लेलिस्ट बैच</span>
          <span class="sm:hidden" data-i18n="calculator.tab-batch-short">बैच</span>
        </button>
      </div>

      <!-- Mode 1: Standard Playback Speed Calculator -->
      <div id="panel-standard" role="tabpanel" aria-labelledby="tab-standard">
        <div class="card" style="max-width: 700px; margin: 0 auto;">
          <div style="margin-bottom: var(--spacing-lg);">
            <div class="eyebrow" style="margin-bottom: var(--spacing-xs);">मोड 1</div>
            <h2 data-i18n="calculator.mode1.title" style="font-size: var(--font-size-heading-lg); font-weight: var(--font-weight-heading-lg); line-height: var(--line-height-heading-lg); letter-spacing: var(--letter-spacing-heading-lg); color: var(--color-ink); margin: 0;">
              मानक प्लेबैक स्पीड
            </h2>
          </div>

          <!-- YouTube URL Auto-Fill (Mode 1) -->
          <div style="margin-bottom: var(--spacing-lg);">
            <div class="label" data-i18n="calculator.label.youtube-url" style="margin-bottom: var(--spacing-sm);">YouTube URL (वैकल्पिक)</div>
            <div style="display: flex; gap: var(--spacing-sm); flex-wrap: wrap; align-items: center;">
              <input type="url" id="std-yt-url" class="input-field" placeholder="https://www.youtube.com/watch?v=..." inputmode="url" style="flex: 1; min-width: 200px;" />
              <button class="btn-ghost" id="std-yt-detect" style="white-space: nowrap;" data-i18n="calculator.btn.detect-duration">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
                पता लगाएं
              </button>
            </div>
            <div id="std-yt-status" style="margin-top: var(--spacing-xs); font-size: var(--font-size-body-sm); min-height: 1.25rem;"></div>
            <button id="std-yt-retry" style="display: none; margin-top: var(--spacing-xs); font-size: var(--font-size-body-sm); background: none; border: none; color: var(--color-link); cursor: pointer; padding: 0;">पुनः प्रयास करें</button>
          </div>

          <!-- Total Time Input (Mode 1) -->
          <div style="margin-bottom: var(--spacing-lg);">
            <div class="label" style="margin-bottom: var(--spacing-xs);">कुल समय</div>
            <div style="display: flex; gap: var(--spacing-sm); align-items: center; flex-wrap: wrap;">
              <input type="text" id="std-total-time" class="input-field" placeholder="1:30:00, 90:00, 5400s" style="flex: 1; min-width: 200px;" />
              <span style="font-size: var(--font-size-body-sm); color: var(--color-mute); white-space: nowrap;">उदा. 1:30:00, 90:00, 5400s</span>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--spacing-md); margin-bottom: var(--spacing-lg);">
            <div>
              <label class="label" data-i18n="calculator.label.hours" for="std-hours">घंटे</label>
              <input type="number" id="std-hours" class="input-field" inputmode="numeric" autocomplete="off" name="std-hours" min="0" max="999" placeholder="0" value="0" />
            </div>
            <div>
              <label class="label" data-i18n="calculator.label.minutes" for="std-minutes">मिनट</label>
              <input type="number" id="std-minutes" class="input-field" inputmode="numeric" autocomplete="off" name="std-minutes" min="0" max="59" placeholder="0" value="0" />
            </div>
            <div>
              <label class="label" data-i18n="calculator.label.seconds" for="std-seconds">सेकंड</label>
              <input type="number" id="std-seconds" class="input-field" inputmode="numeric" autocomplete="off" name="std-seconds" min="0" max="59" placeholder="0" value="0" />
            </div>
          </div>

          <div style="margin-bottom: var(--spacing-lg);">
            <label class="label" data-i18n="calculator.label.speed" for="std-speed">प्लेबैक स्पीड</label>
            <div style="display: flex; gap: var(--spacing-md); align-items: center;">
              <input type="range" id="std-speed-slider" class="speed-slider" min="0.25" max="4" step="0.05" value="1.5" />
              <input type="number" id="std-speed" class="input-field" inputmode="decimal" autocomplete="off" name="std-speed" min="0.1" max="10" step="0.05" value="1.5" style="width: 80px; flex-shrink: 0;" />
            </div>
          </div>

          <div style="margin-bottom: var(--spacing-lg);">
            <div class="label" data-i18n="calculator.label.presets" style="margin-bottom: var(--spacing-sm);">क्विक प्रीसेट</div>
            <div style="display: flex; gap: var(--spacing-xs); flex-wrap: wrap;">
              <button class="preset-btn" data-speed="0.75">0.75x</button>
              <button class="preset-btn" data-speed="1.25">1.25x</button>
              <button class="preset-btn" data-speed="1.5">1.5x</button>
              <button class="preset-btn" data-speed="1.75">1.75x</button>
              <button class="preset-btn" data-speed="2.0">2.0x</button>
              <button class="preset-btn" data-speed="2.5">2.5x</button>
              <button class="preset-btn" data-speed="3.0">3.0x</button>
            </div>
          </div>

          <div class="std-results-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--spacing-md); margin-bottom: var(--spacing-lg);">
            <div class="card" style="text-align: center; padding: var(--spacing-md);">
              <div class="result-label" data-i18n="calculator.result.new-duration">नई अवधि</div>
              <div class="result-value" id="std-new-duration">00:00:00</div>
              <div style="font-size: var(--font-size-body-sm); color: var(--color-mute); margin-top: 4px;" id="std-new-duration-human">0s</div>
            </div>
            <div class="card" style="text-align: center; padding: var(--spacing-md);">
              <div class="result-label" id="std-time-saved-label" data-i18n="calculator.result.time-saved">बचा हुआ समय</div>
              <div class="result-value result-positive" id="std-time-saved">00:00:00</div>
              <div style="font-size: var(--font-size-body-sm); color: var(--color-mute); margin-top: 4px;" id="std-time-saved-human">0s</div>
            </div>
              <div class="card" style="text-align: center; padding: var(--spacing-md);">
                <div class="result-label" style="font-size: var(--font-size-body-xs); color: var(--color-mute); text-transform: uppercase; letter-spacing: 1px;">स्पीड</div>
                <div class="speed-gauge-wrap">
                  <svg class="speed-gauge" viewBox="0 0 200 140" xmlns="http://www.w3.org/2000/svg">
                    <path class="speed-gauge-bg" d="M 20 100 A 80 80 0 0 1 180 100" />
                    <path id="std-gauge-fill" class="speed-gauge-fill" stroke="var(--color-link)" d="M 20 100 A 80 80 0 0 1 20 100" stroke-dasharray="251" stroke-dashoffset="251" />
                  </svg>
                  <div id="std-gauge-label" class="speed-gauge-label">1.0x</div>
                </div>
                <div id="std-mascot" class="speed-mascot">🐢</div>
              </div>
              <div class="card" style="text-align: center; padding: var(--spacing-md);">
                <div class="result-label" data-i18n="calculator.result.percentage-saved">प्रतिशत बचत</div>
                <div class="result-value" id="std-percentage">0%</div>
                <div style="font-size: var(--font-size-body-sm); color: var(--color-mute); margin-top: 4px;">मूल समय का</div>
              </div>
            <div class="card" style="text-align: center; padding: var(--spacing-md);">
              <div class="result-label" style="font-size: var(--font-size-body-sm);">समाप्ति समय (अभी शुरू करें)</div>
              <div class="result-value" id="std-finish-time" style="font-size: var(--font-size-body-md); font-weight: 600; color: var(--color-link);">--:--</div>
              <div style="font-size: var(--font-size-body-xs); color: var(--color-mute); margin-top: 4px;">वर्तमान स्पीड पर</div>
            </div>
            </div>

            <!-- Shareable URL (Mode 1) -->
            <div style="display: flex; gap: var(--spacing-sm); justify-content: flex-end; flex-wrap: wrap;">
              <button class="btn-ghost" id="std-copy-btn" aria-label="क्लिपबोर्ड पर परिणाम कॉपी करें" data-i18n="calculator.btn.copy">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                कॉपी करें
              </button>
              <button class="btn-ghost" id="std-reset-btn" aria-label="कैलकुलेटर रीसेट करें" data-i18n="calculator.btn.reset">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
                रीसेट करें
              </button>
            </div>
        </div>
      </div>

      <!-- Mode 2: Target Finish Time / Reverse Calculator -->
      <div id="panel-reverse" role="tabpanel" aria-labelledby="tab-reverse" style="display: none;">
        <div class="card" style="max-width: 700px; margin: 0 auto;">
          <div style="margin-bottom: var(--spacing-lg);">
            <div class="eyebrow" style="margin-bottom: var(--spacing-xs);">मोड 2</div>
            <h2 data-i18n="calculator.mode2.title" style="font-size: var(--font-size-heading-lg); font-weight: var(--font-weight-heading-lg); line-height: var(--line-height-heading-lg); letter-spacing: var(--letter-spacing-heading-lg); color: var(--color-ink); margin: 0;">
              टारगेट फिनिश टाइम
            </h2>
            <p data-i18n="calculator.mode2.desc" style="font-size: var(--font-size-body-md); color: var(--color-body); margin-top: var(--spacing-xs);">
              अपने उपलब्ध समय विंडो के भीतर मीडिया खत्म करने के लिए आवश्यक सटीक प्लेबैक स्पीड खोजें।
            </p>
          </div>

          <div style="margin-bottom: var(--spacing-lg);">
            <div class="label" data-i18n="calculator.mode2.label.orig" style="margin-bottom: var(--spacing-sm);">मूल मीडिया लंबाई</div>

            <!-- YouTube URL Auto-Fill (Mode 2) -->
            <div style="margin-bottom: var(--spacing-sm);">
              <div class="label" data-i18n="calculator.label.youtube-url" style="margin-bottom: var(--spacing-xs);">YouTube URL (वैकल्पिक)</div>
              <div style="display: flex; gap: var(--spacing-sm); flex-wrap: wrap; align-items: center;">
                <input type="url" id="rev-yt-url" class="input-field" placeholder="https://www.youtube.com/watch?v=..." inputmode="url" style="flex: 1; min-width: 200px;" />
                <button class="btn-ghost" id="rev-yt-detect" style="white-space: nowrap;" data-i18n="calculator.btn.detect-duration">
                  <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
                  पता लगाएं
                </button>
              </div>
              <div id="rev-yt-status" style="margin-top: var(--spacing-xs); font-size: var(--font-size-body-sm); min-height: 1.25rem;"></div>
              <button id="rev-yt-retry" style="display: none; margin-top: var(--spacing-xs); font-size: var(--font-size-body-sm); background: none; border: none; color: var(--color-link); cursor: pointer; padding: 0;">पुनः प्रयास करें</button>
            </div>

            <!-- Total Time Input (Mode 2) -->
            <div style="margin-bottom: var(--spacing-sm);">
              <div class="label" style="margin-bottom: var(--spacing-xs);">कुल समय</div>
              <div style="display: flex; gap: var(--spacing-sm); align-items: center; flex-wrap: wrap;">
                <input type="text" id="rev-total-time" class="input-field" placeholder="1:30:00, 90:00, 5400s" style="flex: 1; min-width: 200px;" />
                <span style="font-size: var(--font-size-body-sm); color: var(--color-mute); white-space: nowrap;">उदा. 1:30:00, 90:00, 5400s</span>
              </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--spacing-md);">
              <div>
                <label class="label" for="rev-orig-hours">घंटे</label>
                <input type="number" id="rev-orig-hours" class="input-field" inputmode="numeric" autocomplete="off" name="rev-orig-hours" min="0" max="999" placeholder="0" value="0" />
              </div>
              <div>
                <label class="label" for="rev-orig-minutes">मिनट</label>
                <input type="number" id="rev-orig-minutes" class="input-field" inputmode="numeric" autocomplete="off" name="rev-orig-minutes" min="0" max="59" placeholder="0" value="0" />
              </div>
              <div>
                <label class="label" for="rev-orig-seconds">सेकंड</label>
                <input type="number" id="rev-orig-seconds" class="input-field" inputmode="numeric" autocomplete="off" name="rev-orig-seconds" min="0" max="59" placeholder="0" value="0" />
              </div>
            </div>
          </div>

          <div style="margin-bottom: var(--spacing-lg);">
            <div class="label" data-i18n="calculator.mode2.label.target" style="margin-bottom: var(--spacing-sm);">उपलब्ध समय विंडो</div>
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--spacing-md);">
              <div>
                <label class="label" for="rev-target-hours">घंटे</label>
                <input type="number" id="rev-target-hours" class="input-field" inputmode="numeric" autocomplete="off" name="rev-target-hours" min="0" max="999" placeholder="0" value="0" />
              </div>
              <div>
                <label class="label" for="rev-target-minutes">मिनट</label>
                <input type="number" id="rev-target-minutes" class="input-field" inputmode="numeric" autocomplete="off" name="rev-target-minutes" min="0" max="59" placeholder="0" value="0" />
              </div>
              <div>
                <label class="label" for="rev-target-seconds">सेकंड</label>
                <input type="number" id="rev-target-seconds" class="input-field" inputmode="numeric" autocomplete="off" name="rev-target-seconds" min="0" max="59" placeholder="0" value="0" />
              </div>
            </div>
          </div>

          <div class="rev-results-grid" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--spacing-md); margin-bottom: var(--spacing-lg);">
            <div class="card" style="text-align: center; padding: var(--spacing-md);">
              <div class="result-label" data-i18n="calculator.mode2.result.required-speed">आवश्यक स्पीड</div>
              <div class="result-value" id="rev-required-speed">0.00x</div>
              <div style="font-size: var(--font-size-body-sm); color: var(--color-mute); margin-top: 4px;" id="rev-speed-description">ऊपर अवधि दर्ज करें</div>
            </div>
            <div class="card" style="text-align: center; padding: var(--spacing-md);">
              <div class="result-label" data-i18n="calculator.mode2.result.time-saved">बचा हुआ समय</div>
              <div class="result-value result-positive" id="rev-time-saved">00:00:00</div>
              <div style="font-size: var(--font-size-body-sm); color: var(--color-mute); margin-top: 4px;" id="rev-time-saved-human">0s</div>
            </div>
          </div>

            <div id="rev-warning" style="display: none; padding: var(--spacing-md); background-color: var(--color-warning-soft); border: 1px solid var(--color-warning); border-radius: var(--radius-md); margin-bottom: var(--spacing-lg); color: var(--color-warning-deep); font-size: var(--font-size-body-md);">
            </div>

            <div style="display: flex; gap: var(--spacing-sm); justify-content: flex-end; flex-wrap: wrap;">
            <button class="btn-ghost" id="rev-copy-btn" aria-label="क्लिपबोर्ड पर परिणाम कॉपी करें" data-i18n="calculator.btn.copy">
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              कॉपी करें
            </button>
              <button class="btn-ghost" id="rev-reset-btn" aria-label="कैलकुलेटर रीसेट करें" data-i18n="calculator.btn.reset">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
                रीसेट करें
              </button>
            </div>
        </div>
      </div>

      <!-- Mode 3: Multi-Video / Playlist Batch Calculator -->
      <div id="panel-batch" role="tabpanel" aria-labelledby="tab-batch" style="display: none;">
