---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Examples — Playback speed Calculator" description="Multi-speed quick reference table for common video and audio durations." lang="en" device="desktop">
  <section style="padding: var(--spacing-3xl) var(--spacing-lg); background-color: var(--color-canvas);">
    <div class="section-container">
      <div style="text-align: center; margin-bottom: var(--spacing-3xl);">
        <div class="eyebrow" style="margin-bottom: var(--spacing-md);">QUICK REFERENCE</div>
        <h1 style="font-size: var(--font-size-heading-lg); font-weight: var(--font-weight-heading-lg); line-height: var(--line-height-heading-lg); letter-spacing: var(--letter-spacing-heading-lg); color: var(--color-ink); margin: 0 0 var(--spacing-md);" data-i18n="examples.title">Common scenarios</h1>
        <p style="font-size: var(--font-size-body-md); color: var(--color-body); max-width: 640px; margin: 0 auto;">
          See exactly how long media takes at common playback speeds, and how much time you save.
        </p>
      </div>

      <!-- Multi-speed quick reference matrix (scrollable on mobile) -->
      <div style="overflow-x: auto; -webkit-overflow-scrolling: touch; border: 1px solid var(--color-hairline); border-radius: var(--radius-lg); background: var(--color-canvas-elevated);">
        <table style="width: 100%; border-collapse: collapse; min-width: 820px; font-size: var(--font-size-body-md);">
          <caption style="text-align: left; padding: var(--spacing-md) var(--spacing-lg); font-size: var(--font-size-body-sm); color: var(--color-mute); caption-side: top;">
            New duration and time saved at each playback speed. Negative savings (0.75x) means time added.
          </caption>
          <thead>
            <tr>
              <th style="text-align: left; padding: var(--spacing-sm) var(--spacing-md); border-bottom: 2px solid var(--color-hairline); color: var(--color-ink); font-weight: 600; white-space: nowrap;" data-i18n="examples.table.original-duration">Original Duration</th>
              <th style="text-align: left; padding: var(--spacing-sm) var(--spacing-md); border-bottom: 2px solid var(--color-hairline); color: var(--color-ink); font-weight: 600; white-space: nowrap;" data-i18n="examples.table.speed">Speed</th>
              <th style="text-align: left; padding: var(--spacing-sm) var(--spacing-md); border-bottom: 2px solid var(--color-hairline); color: var(--color-ink); font-weight: 600; white-space: nowrap;" data-i18n="examples.table.new-duration">New Duration</th>
              <th style="text-align: left; padding: var(--spacing-sm) var(--spacing-md); border-bottom: 2px solid var(--color-hairline); color: var(--color-ink); font-weight: 600; white-space: nowrap;" data-i18n="examples.table.time-saved">Time Saved</th>
            </tr>
          </thead>
          <tbody>
            <!-- 15 min -->
