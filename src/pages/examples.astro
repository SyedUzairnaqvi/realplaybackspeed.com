---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Examples — Real Playback Speed" description="Common playback speed scenarios." lang="en" device="desktop">
  <section style="padding: var(--spacing-3xl) var(--spacing-lg); background-color: var(--color-canvas);">
    <div class="section-container">
      <div style="text-align: center; margin-bottom: var(--spacing-3xl);">
        <div class="eyebrow" style="margin-bottom: var(--spacing-md);">EXAMPLES</div>
        <h1 style="font-size: var(--font-size-heading-lg); font-weight: var(--font-weight-heading-lg); line-height: var(--line-height-heading-lg); letter-spacing: var(--letter-spacing-heading-lg); color: var(--color-ink); margin: 0 0 var(--spacing-md);" data-i18n="examples.title">Common scenarios</h1>
      </div>

      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; font-size: var(--font-size-body-md);">
          <thead>
            <tr>
              <th style="text-align: left; padding: var(--spacing-sm) var(--spacing-md); border-bottom: 2px solid var(--color-hairline); color: var(--color-ink); font-weight: 600;" data-i18n="examples.table.original-duration">Original Duration</th>
              <th style="text-align: left; padding: var(--spacing-sm) var(--spacing-md); border-bottom: 2px solid var(--color-hairline); color: var(--color-ink); font-weight: 600;" data-i18n="examples.table.speed">Speed</th>
              <th style="text-align: left; padding: var(--spacing-sm) var(--spacing-md); border-bottom: 2px solid var(--color-hairline); color: var(--color-ink); font-weight: 600;" data-i18n="examples.table.new-duration">New Duration</th>
              <th style="text-align: left; padding: var(--spacing-sm) var(--spacing-md); border-bottom: 2px solid var(--color-hairline); color: var(--color-ink); font-weight: 600;" data-i18n="examples.table.time-saved">Time Saved</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td style="padding: var(--spacing-sm) var(--spacing-md); border-bottom: 1px solid var(--color-hairline); color: var(--color-body); font-family: var(--font-family-mono);">01:00:00</td>
              <td style="padding: var(--spacing-sm) var(--spacing-md); border-bottom: 1px solid var(--color-hairline); color: var(--color-body); font-family: var(--font-family-mono);">1.5x</td>
              <td style="padding: var(--spacing-sm) var(--spacing-md); border-bottom: 1px solid var(--color-hairline); color: var(--color-body); font-family: var(--font-family-mono);">00:40:00</td>
              <td style="padding: var(--spacing-sm) var(--spacing-md); border-bottom: 1px solid var(--color-hairline); color: var(--color-link); font-family: var(--font-family-mono);">00:20:00 (33%)</td>
            </tr>
            <tr>
              <td style="padding: var(--spacing-sm) var(--spacing-md); border-bottom: 1px solid var(--color-hairline); color: var(--color-body); font-family: var(--font-family-mono);">00:45:30</td>
              <td style="padding: var(--spacing-sm) var(--spacing-md); border-bottom: 1px solid var(--color-hairline); color: var(--color-body); font-family: var(--font-family-mono);">1.5x</td>
              <td style="padding: var(--spacing-sm) var(--spacing-md); border-bottom: 1px solid var(--color-hairline); color: var(--color-body); font-family: var(--font-family-mono);">00:30:20</td>
              <td style="padding: var(--spacing-sm) var(--spacing-md); border-bottom: 1px solid var(--color-hairline); color: var(--color-link); font-family: var(--font-family-mono);">00:15:10 (33%)</td>
            </tr>
            <tr>
              <td style="padding: var(--spacing-sm) var(--spacing-md); border-bottom: 1px solid var(--color-hairline); color: var(--color-body); font-family: var(--font-family-mono);">07:30:00</td>
              <td style="padding: var(--spacing-sm) var(--spacing-md); border-bottom: 1px solid var(--color-hairline); color: var(--color-body); font-family: var(--font-family-mono);">1.5x</td>
              <td style="padding: var(--spacing-sm) var(--spacing-md); border-bottom: 1px solid var(--color-hairline); color: var(--color-body); font-family: var(--font-family-mono);">05:00:00</td>
              <td style="padding: var(--spacing-sm) var(--spacing-md); border-bottom: 1px solid var(--color-hairline); color: var(--color-link); font-family: var(--font-family-mono);">02:30:00 (33%)</td>
            </tr>
            <tr>
              <td style="padding: var(--spacing-sm) var(--spacing-md); border-bottom: 1px solid var(--color-hairline); color: var(--color-body); font-family: var(--font-family-mono);">00:08:00</td>
              <td style="padding: var(--spacing-sm) var(--spacing-md); border-bottom: 1px solid var(--color-hairline); color: var(--color-body); font-family: var(--font-family-mono);">1.25x</td>
              <td style="padding: var(--spacing-sm) var(--spacing-md); border-bottom: 1px solid var(--color-hairline); color: var(--color-body); font-family: var(--font-family-mono);">00:06:24</td>
              <td style="padding: var(--spacing-sm) var(--spacing-md); border-bottom: 1px solid var(--color-hairline); color: var(--color-link); font-family: var(--font-family-mono);">00:01:36 (20%)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Layout>
