              <td style="padding: var(--spacing-sm) var(--spacing-md); border-bottom: 1px solid var(--color-hairline); color: var(--color-body); font-family: var(--font-family-mono); white-space: nowrap;">00:15:00</td>
              <td style="padding: var(--spacing-sm) var(--spacing-md); border-bottom: 1px solid var(--color-hairline); color: var(--color-body); font-family: var(--font-family-mono); white-space: nowrap; font-weight: 600;">0.75x</td>
