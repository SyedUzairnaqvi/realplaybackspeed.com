            "text": "Yes. Watching at a faster speed reduces total watch time because the same content plays in less time. A 60-minute video at 1.5x results in 40 minutes of watch time."
          }
        },
        {
          "@type": "Question",
          "name": "How long is 1 hour in 1.5 speed?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "One hour at 1.5x playback speed takes 40 minutes. You save 20 minutes. 60 minutes divided by 1.5 equals 40 minutes."
          }
        },
        {
          "@type": "Question",
          "name": "Can I calculate multiple videos at once?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Playlist Batch mode lets you enter several video durations and see the total adjusted time and time saved across all of them at your chosen speed."
          }
        },
        {
          "@type": "Question",
          "name": "How to increase playback speed shortcut?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "On YouTube in a web browser, hold Shift and press the greater-than key to increase speed, or Shift and the comma key to decrease it."
          }
        }
      ]
    }
  </script>

  <!-- Toast Notification -->
  <div id="toast" style="display: none;" class="toast" role="status" aria-live="polite" aria-atomic="true"></div>

  <!-- Keyboard Shortcuts Help Modal -->
  <div id="shortcuts-modal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center; padding: var(--spacing-lg);">
    <div class="card" style="max-width: 400px; width: 100%; box-shadow: var(--shadow-floating);">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--spacing-lg);">
        <h3 style="font-size: var(--font-size-heading-md); font-weight: var(--font-weight-heading-md); color: var(--color-ink); margin: 0;">Keyboard Shortcuts</h3>
        <button class="btn-icon" id="close-shortcuts" style="width: 32px; height: 32px;" aria-label="Close shortcuts dialog">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <div style="display: flex; flex-direction: column; gap: var(--spacing-sm);">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <span style="color: var(--color-body);">Preset speeds 0.75x–3.0x</span>
          <span><kbd class="kbd">1</kbd> <kbd class="kbd">2</kbd> <kbd class="kbd">3</kbd> <kbd class="kbd">4</kbd> <kbd class="kbd">5</kbd> <kbd class="kbd">6</kbd> <kbd class="kbd">7</kbd> <kbd class="kbd">8</kbd></span>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <span style="color: var(--color-body);">Copy results</span>
          <span><kbd class="kbd">C</kbd></span>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <span style="color: var(--color-body);">Reset calculator</span>
          <span><kbd class="kbd">R</kbd></span>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <span style="color: var(--color-body);">Switch modes</span>
          <span><kbd class="kbd">Tab</kbd> / <kbd class="kbd">Shift+Tab</kbd></span>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <span style="color: var(--color-body);">Show shortcuts</span>
          <span><kbd class="kbd">?</kbd></span>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Time formatting utilities (inlined for client-side)
    function parseTimeToSeconds(timeInput) {
      const trimmed = timeInput.trim();
      if (!trimmed) return 0;
      if (/^\d+(\.\d+)?$/.test(trimmed)) {
        return parseFloat(trimmed);
      }
      const parts = trimmed.split(':').map(p => parseFloat(p));
      if (parts.some(isNaN)) return 0;
      if (parts.length === 3) {
        return parts[0] * 3600 + parts[1] * 60 + parts[2];
      } else if (parts.length === 2) {
        return parts[0] * 60 + parts[1];
      } else if (parts.length === 1) {
        return parts[0];
      }
      return 0;
    }

    function formatSeconds(seconds, showHours = true) {
      const totalSeconds = Math.max(0, Math.round(seconds));
      const hours = Math.floor(totalSeconds / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const secs = totalSeconds % 60;
      if (showHours || hours > 0) {
        return `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
      }
      return `${minutes.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
    }

    function formatDuration(seconds) {
      const totalSeconds = Math.max(0, Math.round(seconds));
      const hours = Math.floor(totalSeconds / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const secs = totalSeconds % 60;
      const parts = [];
      if (hours > 0) parts.push(`${hours}h`);
      if (minutes > 0) parts.push(`${minutes}m`);
      if (secs > 0 || parts.length === 0) parts.push(`${secs}s`);
      return parts.join(' ');
    }

    function calculatePlayback(originalSeconds, speed) {
      if (originalSeconds <= 0 || speed <= 0) {
        return { originalSeconds, speed, adjustedSeconds: 0, timeSaved: 0, percentageSaved: 0 };
      }
      const adjustedSeconds = originalSeconds / speed;
      const timeSaved = originalSeconds - adjustedSeconds;
      const percentageSaved = (timeSaved / originalSeconds) * 100;
      return { originalSeconds, speed, adjustedSeconds, timeSaved, percentageSaved };
    }

    function calculateRequiredSpeed(originalSeconds, targetSeconds) {
      if (originalSeconds <= 0 || targetSeconds <= 0) {
        return { originalSeconds, targetSeconds, requiredSpeed: 0, isPossible: false, message: 'Please enter valid durations' };
      }
      const requiredSpeed = originalSeconds / targetSeconds;
      if (requiredSpeed < 0.1) {
        return { originalSeconds, targetSeconds, requiredSpeed, isPossible: false, message: `Required speed (${requiredSpeed.toFixed(2)}x) is too slow. Minimum practical speed is 0.1x.` };
      }
      if (requiredSpeed > 16) {
        return { originalSeconds, targetSeconds, requiredSpeed, isPossible: false, message: `Required speed (${requiredSpeed.toFixed(2)}x) is too fast. Maximum practical speed is 16x.` };
      }
      return { originalSeconds, targetSeconds, requiredSpeed, isPossible: true };
    }

    // ============================================
    // YOUTUBE URL AUTO-FILL (no API key)
    // ============================================
    function parseYouTubeId(url) {
      if (!url) return null;
      const trimmed = url.trim();
      const patterns = [
        /(?:youtube\.com\/watch\?v=|m\.youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/shorts\/)([a-zA-Z0-9_-]{11})/,
        /youtube\.com\/embed\/([a-zA-Z0-9_-]{11})/,
        /youtube\.com\/v\/([a-zA-Z0-9_-]{11})/,
      ];
      for (const re of patterns) {
        const m = trimmed.match(re);
        if (m) return m[1];
      }
      return null;
    }

    async function fetchYouTubeMetadata(videoId) {
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 20000);
      try {
        const res = await fetch(`/api/youtube-duration?v=${encodeURIComponent(videoId)}`, {
          signal: controller.signal,
          headers: { 'Accept': 'application/json' },
        });
        if (!res.ok) throw new Error('server responded ' + res.status);
        return await res.json();
      } finally {
        clearTimeout(timeout);
      }
    }

    function setStdDuration(h, m, s) {
      stdState.hours = h;
      stdState.minutes = m;
      stdState.seconds = s;
      document.getElementById('std-hours').value = h;
      document.getElementById('std-minutes').value = m;
      document.getElementById('std-seconds').value = s;
      document.getElementById('std-total-time').value = formatSeconds(h * 3600 + m * 60 + s);
      calculateStd();
    }

    // Parse total time from formats: 1:30:00, 90:00, 5400s, 1h 30m, 3600
    function parseTotalTime(input) {
      if (!input) return 0;
      const v = input.trim();
      if (!v) return 0;

      // Plain seconds: 5400 or 5400s
      const plainSeconds = v.match(/^(\d+)s?$/i);
      if (plainSeconds) return parseInt(plainSeconds[1], 10);

      // Hours with h: 1h30m or 1h or 1h 30m
      const hMatch = v.match(/^(\d+)\s*h\s*(?:(\d+)\s*m)?(?:(\d+)\s*s?)?$/i);
      if (hMatch) {
        return parseInt(hMatch[1], 10) * 3600 + (hMatch[2] ? parseInt(hMatch[2], 10) : 0) * 60 + (hMatch[3] ? parseInt(hMatch[3], 10) : 0);
      }

      // MM:SS or HH:MM:SS
      const parts = v.split(':').map(p => parseInt(p, 10));
      if (parts.every(p => !isNaN(p))) {
        if (parts.length === 3) return parts[0] * 3600 + parts[1] * 60 + parts[2];
        if (parts.length === 2) return parts[0] * 60 + parts[1];
        if (parts.length === 1) return parts[0];
      }
      return 0;
    }

    function setStdTotalTime() {
      clearYtWarning('std-yt-status');
      const input = document.getElementById('std-total-time');
      if (!input) return;
      const seconds = parseTotalTime(input.value);
      if (seconds <= 0) return;
      const h = Math.floor(seconds / 3600);
      const m = Math.floor((seconds % 3600) / 60);
      const s = seconds % 60;
      stdState.hours = h;
      stdState.minutes = m;
      stdState.seconds = s;
      document.getElementById('std-hours').value = h;
      document.getElementById('std-minutes').value = m;
      document.getElementById('std-seconds').value = s;
      calculateStd();
    }

    function clearYtWarning(statusId) {
      const el = document.getElementById(statusId);
      if (el) {
        el.textContent = '';
        el.style.color = '';
      }
    }

    async function handleStdYouTubeDetect() {
      const urlInput = document.getElementById('std-yt-url');
      const statusEl = document.getElementById('std-yt-status');
      const videoId = parseYouTubeId(urlInput.value);
      if (!videoId) {
        statusEl.textContent = '';
        statusEl.style.color = '';
        return;
      }
      statusEl.textContent = 'Fetching video info…';
      statusEl.style.color = 'var(--color-mute)';
      try {
        const meta = await fetchYouTubeMetadata(videoId);
        if (meta.durationSeconds > 0) {
          const h = Math.floor(meta.durationSeconds / 3600);
          const m = Math.floor((meta.durationSeconds % 3600) / 60);
          const s = meta.durationSeconds % 60;
          setStdDuration(h, m, s);
          statusEl.textContent = meta.title + ' — Duration auto-filled';
          statusEl.style.color = 'var(--color-success-deep)';
          showToast(meta.title + ' — duration auto-filled');
        } else {
          statusEl.textContent = 'Could not auto-detect duration — enter time manually below';
          statusEl.style.color = 'var(--color-warning-deep)';
        }
      } catch (err) {
        statusEl.textContent = 'Could not auto-detect duration — enter time manually below';
        statusEl.style.color = 'var(--color-warning-deep)';
      }
    }

    // Toast notification
    function showToast(message, duration = 2000) {
      const toast = document.getElementById('toast');
      toast.textContent = message;
      toast.style.display = 'block';
      setTimeout(() => {
        toast.style.display = 'none';
      }, duration);
    }

    // Copy to clipboard
    async function copyToClipboard(text) {
      try {
        await navigator.clipboard.writeText(text);
        showToast('Copied to clipboard!');
        return true;
      } catch (err) {
        const textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        try {
          document.execCommand('copy');
          showToast('Copied to clipboard!');
          return true;
        } catch (e) {
          showToast('Failed to copy');
          return false;
        } finally {
          document.body.removeChild(textarea);
        }
      }
    }

    // ============================================
    // MODE 1: STANDARD PLAYBACK SPEED CALCULATOR
    // ============================================
    let stdState = {
      hours: 0,
      minutes: 0,
      seconds: 0,
      speed: 1.5,
    };

    function getStdOriginalSeconds() {
      return stdState.hours * 3600 + stdState.minutes * 60 + stdState.seconds;
    }

    function updateStdPresetButtons() {
      const presetBtns = document.querySelectorAll('#panel-standard .preset-btn');
      presetBtns.forEach(btn => {
        const speed = parseFloat(btn.dataset.speed);
        if (Math.abs(speed - stdState.speed) < 0.01) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
    }

    function calculateStd() {
      const originalSeconds = getStdOriginalSeconds();
      const result = calculatePlayback(originalSeconds, stdState.speed);

      document.getElementById('std-new-duration').textContent = formatSeconds(result.adjustedSeconds);
      document.getElementById('std-new-duration-human').textContent = formatDuration(result.adjustedSeconds);

      const savedLabel = document.getElementById('std-time-saved-label');
      const savedEl = document.getElementById('std-time-saved');
      const savedHumanEl = document.getElementById('std-time-saved-human');

      if (stdState.speed < 1) {
        // Slow playback -> time added
        savedLabel.textContent = 'Time Added';
        savedEl.textContent = '+' + formatSeconds(Math.abs(result.timeSaved));
        savedHumanEl.textContent = '+' + formatDuration(Math.abs(result.timeSaved));
        savedEl.classList.remove('result-positive');
        savedEl.style.color = 'var(--color-warning-deep)';
      } else {
        savedLabel.textContent = 'Time Saved';
        savedEl.textContent = formatSeconds(result.timeSaved);
        savedHumanEl.textContent = formatDuration(result.timeSaved);
        savedEl.classList.add('result-positive');
        savedEl.style.color = '';
      }

      document.getElementById('std-percentage').textContent = result.percentageSaved.toFixed(1) + '%';

      updateStdPresetButtons();
    }

    // Mode 1 event listeners
    function syncStdTotalTimeFromHMS() {
      document.getElementById('std-total-time').value = formatSeconds(stdState.hours * 3600 + stdState.minutes * 60 + stdState.seconds);
    }
    document.getElementById('std-hours').addEventListener('input', (e) => {
      stdState.hours = parseInt(e.target.value) || 0;
      syncStdTotalTimeFromHMS();
      calculateStd();
      clearYtWarning('std-yt-status');
    });
    document.getElementById('std-minutes').addEventListener('input', (e) => {
      stdState.minutes = parseInt(e.target.value) || 0;
      syncStdTotalTimeFromHMS();
      calculateStd();
      clearYtWarning('std-yt-status');
    });
    document.getElementById('std-seconds').addEventListener('input', (e) => {
      stdState.seconds = parseInt(e.target.value) || 0;
      syncStdTotalTimeFromHMS();
      calculateStd();
      clearYtWarning('std-yt-status');
    });
    document.getElementById('std-total-time').addEventListener('change', setStdTotalTime);
    document.getElementById('std-total-time').addEventListener('blur', setStdTotalTime);
    document.getElementById('std-speed').addEventListener('input', (e) => {
      stdState.speed = parseFloat(e.target.value) || 1;
      document.getElementById('std-speed-slider').value = stdState.speed;
      calculateStd();
    });
    document.getElementById('std-speed-slider').addEventListener('input', (e) => {
      stdState.speed = parseFloat(e.target.value);
      document.getElementById('std-speed').value = stdState.speed.toFixed(2);
      calculateStd();
    });

    // Preset buttons for Mode 1
    document.querySelectorAll('#panel-standard .preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        stdState.speed = parseFloat(btn.dataset.speed);
        document.getElementById('std-speed').value = stdState.speed.toFixed(2);
        document.getElementById('std-speed-slider').value = stdState.speed;
        calculateStd();
      });
    });

    // YouTube auto-detect for Mode 1
    document.getElementById('std-yt-detect').addEventListener('click', handleStdYouTubeDetect);
    document.getElementById('std-yt-url').addEventListener('change', handleStdYouTubeDetect);
    document.getElementById('std-yt-url').addEventListener('blur', handleStdYouTubeDetect);

    // Copy/Share/Reset for Mode 1
    document.getElementById('std-copy-btn').addEventListener('click', () => {
      const originalSeconds = getStdOriginalSeconds();
      const result = calculatePlayback(originalSeconds, stdState.speed);
      const text = `Original: ${formatSeconds(originalSeconds)} | Speed: ${stdState.speed}x | New Duration: ${formatSeconds(result.adjustedSeconds)} | Time Saved: ${formatSeconds(result.timeSaved)} (${result.percentageSaved.toFixed(1)}%)`;
      copyToClipboard(text);
    });

    document.getElementById('std-reset-btn').addEventListener('click', () => {
      stdState = { hours: 0, minutes: 0, seconds: 0, speed: 1.5 };
      document.getElementById('std-hours').value = 0;
      document.getElementById('std-minutes').value = 0;
      document.getElementById('std-seconds').value = 0;
      document.getElementById('std-total-time').value = '';
      document.getElementById('std-speed').value = 1.5;
      document.getElementById('std-speed-slider').value = 1.5;
      clearYtWarning('std-yt-status');
      calculateStd();
    });

    // ============================================
    // MODE 2: TARGET FINISH TIME / REVERSE CALCULATOR
    // ============================================
    let revState = {
      origHours: 0,
      origMinutes: 0,
      origSeconds: 0,
      targetHours: 0,
      targetMinutes: 0,
      targetSeconds: 0,
    };

    function getRevOriginalSeconds() {
      return revState.origHours * 3600 + revState.origMinutes * 60 + revState.origSeconds;
    }

    function getRevTargetSeconds() {
      return revState.targetHours * 3600 + revState.targetMinutes * 60 + revState.targetSeconds;
    }

    function setRevDuration(h, m, s) {
      revState.origHours = h;
      revState.origMinutes = m;
      revState.origSeconds = s;
      document.getElementById('rev-orig-hours').value = h;
      document.getElementById('rev-orig-minutes').value = m;
      document.getElementById('rev-orig-seconds').value = s;
      document.getElementById('rev-total-time').value = formatSeconds(h * 3600 + m * 60 + s);
      calculateRev();
    }

    function setRevTotalTime() {
      clearYtWarning('rev-yt-status');
      const input = document.getElementById('rev-total-time');
      if (!input) return;
      const seconds = parseTotalTime(input.value);
      if (seconds <= 0) return;
      const h = Math.floor(seconds / 3600);
      const m = Math.floor((seconds % 3600) / 60);
      const s = seconds % 60;
      revState.origHours = h;
      revState.origMinutes = m;
      revState.origSeconds = s;
      document.getElementById('rev-orig-hours').value = h;
      document.getElementById('rev-orig-minutes').value = m;
      document.getElementById('rev-orig-seconds').value = s;
      calculateRev();
    }

    async function handleRevYouTubeDetect() {
      const urlInput = document.getElementById('rev-yt-url');
      const statusEl = document.getElementById('rev-yt-status');
      const videoId = parseYouTubeId(urlInput.value);
      if (!videoId) {
        statusEl.textContent = '';
        statusEl.style.color = '';
        return;
      }
      statusEl.textContent = 'Fetching video info…';
      statusEl.style.color = 'var(--color-mute)';
      try {
        const meta = await fetchYouTubeMetadata(videoId);
        if (meta.durationSeconds > 0) {
          const h = Math.floor(meta.durationSeconds / 3600);
          const m = Math.floor((meta.durationSeconds % 3600) / 60);
          const s = meta.durationSeconds % 60;
          setRevDuration(h, m, s);
          statusEl.textContent = meta.title + ' — Duration auto-filled';
          statusEl.style.color = 'var(--color-success-deep)';
          showToast(meta.title + ' — duration auto-filled');
        } else {
          statusEl.textContent = 'Could not auto-detect duration — enter time manually below';
          statusEl.style.color = 'var(--color-warning-deep)';
        }
      } catch (err) {
        statusEl.textContent = 'Could not auto-detect duration — enter time manually below';
        statusEl.style.color = 'var(--color-warning-deep)';
      }
    }

    function calculateRev() {
      const originalSeconds = getRevOriginalSeconds();
      const targetSeconds = getRevTargetSeconds();
      const result = calculateRequiredSpeed(originalSeconds, targetSeconds);

      const speedEl = document.getElementById('rev-required-speed');
      const descEl = document.getElementById('rev-speed-description');
      const savedEl = document.getElementById('rev-time-saved');
      const savedHumanEl = document.getElementById('rev-time-saved-human');
      const warningEl = document.getElementById('rev-warning');

      if (originalSeconds <= 0 || targetSeconds <= 0) {
        speedEl.textContent = '0.00x';
        descEl.textContent = 'Enter durations above';
        savedEl.textContent = '00:00:00';
        savedHumanEl.textContent = '0s';
        warningEl.style.display = 'none';
        return;
      }

      if (!result.isPossible) {
        speedEl.textContent = `${result.requiredSpeed.toFixed(2)}x`;
        descEl.textContent = 'Not practical';
        savedEl.textContent = '00:00:00';
        savedHumanEl.textContent = '0s';
        warningEl.style.display = 'block';
        warningEl.textContent = result.message;
        return;
      }

      speedEl.textContent = `${result.requiredSpeed.toFixed(2)}x`;
      descEl.textContent = result.requiredSpeed > 1 ? 'Speed up to finish' : 'Slow down to finish';

      const timeSaved = originalSeconds - targetSeconds;
      savedEl.textContent = formatSeconds(timeSaved);
      savedHumanEl.textContent = formatDuration(timeSaved);

      warningEl.style.display = 'none';

      if (result.requiredSpeed > 2) {
        speedEl.style.color = 'var(--color-warning-deep)';
      } else if (result.requiredSpeed > 1) {
        speedEl.style.color = 'var(--color-link)';
      } else {
        speedEl.style.color = 'var(--color-ink)';
      }
    }

    // Mode 2 event listeners
    function syncRevTotalTimeFromHMS() {
      document.getElementById('rev-total-time').value = formatSeconds(revState.origHours * 3600 + revState.origMinutes * 60 + revState.origSeconds);
    }
    ['orig-hours', 'orig-minutes', 'orig-seconds', 'target-hours', 'target-minutes', 'target-seconds'].forEach(id => {
      const el = document.getElementById(`rev-${id}`);
      if (el) {
        el.addEventListener('input', (e) => {
          const value = parseInt(e.target.value) || 0;
          const key = id.replace(/-/g, '');
          const stateMap = {
            'orighours': 'origHours',
            'origminutes': 'origMinutes',
            'origseconds': 'origSeconds',
            'targethours': 'targetHours',
            'targetminutes': 'targetMinutes',
            'targetseconds': 'targetSeconds',
          };
          revState[stateMap[id.replace(/-/g, '')]] = value;
          if (id.startsWith('orig')) {
            syncRevTotalTimeFromHMS();
          }
          calculateRev();
          clearYtWarning('rev-yt-status');
        });
      }
    });
    document.getElementById('rev-total-time').addEventListener('change', setRevTotalTime);
    document.getElementById('rev-total-time').addEventListener('blur', setRevTotalTime);

    // YouTube auto-detect for Mode 2
    document.getElementById('rev-yt-detect').addEventListener('click', handleRevYouTubeDetect);
    document.getElementById('rev-yt-url').addEventListener('change', handleRevYouTubeDetect);
    document.getElementById('rev-yt-url').addEventListener('blur', handleRevYouTubeDetect);

    document.getElementById('rev-copy-btn').addEventListener('click', () => {
      const originalSeconds = getRevOriginalSeconds();
      const targetSeconds = getRevTargetSeconds();
      const result = calculateRequiredSpeed(originalSeconds, targetSeconds);
      const text = `Original: ${formatSeconds(originalSeconds)} | Target: ${formatSeconds(targetSeconds)} | Required Speed: ${result.requiredSpeed.toFixed(2)}x | Time Saved: ${formatSeconds(originalSeconds - targetSeconds)}`;
      copyToClipboard(text);
    });

    document.getElementById('rev-reset-btn').addEventListener('click', () => {
      revState = { origHours: 0, origMinutes: 0, origSeconds: 0, targetHours: 0, targetMinutes: 0, targetSeconds: 0 };
      ['orig-hours', 'orig-minutes', 'orig-seconds', 'target-hours', 'target-minutes', 'target-seconds'].forEach(id => {
        const el = document.getElementById(`rev-${id}`);
        if (el) el.value = 0;
      });
      document.getElementById('rev-total-time').value = '';
      clearYtWarning('rev-yt-status');
      calculateRev();
    });

    // ============================================
    // MODE 3: PLAYLIST BATCH CALCULATOR
    // ============================================
    let batchState = {
      speed: 1.5,
      items: [],
      nextId: 1,
    };

    function getBatchOriginalSeconds() {
      return batchState.items.reduce((sum, item) => sum + item.totalSeconds, 0);
    }

    function renderBatchList() {
      const listEl = document.getElementById('batch-list');
      if (batchState.items.length === 0) {
        listEl.innerHTML = '<div style="text-align: center; padding: var(--spacing-lg); color: var(--color-mute); font-size: var(--font-size-body-md);">No videos added yet. Add one above.</div>';
        return;
      }

      listEl.innerHTML = batchState.items.map((item, index) => `
        <div class="playlist-item" data-id="${item.id}">
          <div style="flex: 1; min-width: 0;">
            <div style="font-weight: 500; color: var(--color-ink); font-size: var(--font-size-body-md); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${item.title || `Video ${index + 1}`}</div>
            <div style="font-size: var(--font-size-body-sm); color: var(--color-mute); font-family: var(--font-family-mono);">${formatSeconds(item.totalSeconds)}</div>
          </div>
          <button class="btn-icon" style="width: 32px; height: 32px; flex-shrink: 0;" data-remove="${item.id}" aria-label="Remove ${item.title || `Video ${index + 1}`}">
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>
      `).join('');

      listEl.querySelectorAll('[data-remove]').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.remove;
          batchState.items = batchState.items.filter(item => item.id !== id);
          renderBatchList();
          calculateBatch();
        });
      });
    }

    function calculateBatch() {
      const totalOriginal = getBatchOriginalSeconds();
      const speed = batchState.speed;

      let totalAdjusted = 0;
      let totalTimeSaved = 0;
      let percentageSaved = 0;

      if (totalOriginal > 0 && speed > 0) {
        totalAdjusted = totalOriginal / speed;
        totalTimeSaved = totalOriginal - totalAdjusted;
        percentageSaved = (totalTimeSaved / totalOriginal) * 100;
      }

      document.getElementById('batch-count').textContent = batchState.items.length;
      document.getElementById('batch-original').textContent = formatSeconds(totalOriginal);
      document.getElementById('batch-original-human').textContent = formatDuration(totalOriginal);
      document.getElementById('batch-adjusted').textContent = formatSeconds(totalAdjusted);
      document.getElementById('batch-adjusted-human').textContent = formatDuration(totalAdjusted);
      document.getElementById('batch-saved').textContent = formatSeconds(totalTimeSaved);
      document.getElementById('batch-saved-human').textContent = formatDuration(totalTimeSaved);
    }

    // Batch event listeners
    document.getElementById('batch-speed').addEventListener('input', (e) => {
      batchState.speed = parseFloat(e.target.value) || 1;
      document.getElementById('batch-speed-slider').value = batchState.speed;
      calculateBatch();
    });
    document.getElementById('batch-speed-slider').addEventListener('input', (e) => {
      batchState.speed = parseFloat(e.target.value);
      document.getElementById('batch-speed').value = batchState.speed.toFixed(2);
      calculateBatch();
    });

    // Preset buttons for Mode 3 (Batch)
    document.querySelectorAll('#panel-batch .preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        batchState.speed = parseFloat(btn.dataset.speed);
        document.getElementById('batch-speed').value = batchState.speed.toFixed(2);
        document.getElementById('batch-speed-slider').value = batchState.speed;
        calculateBatch();
      });
    });

    ['batch-title', 'batch-hours', 'batch-minutes', 'batch-seconds'].forEach(id => {
      document.getElementById(id).addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          document.getElementById('batch-add-btn').click();
        }
      });
    });

    document.getElementById('batch-add-btn').addEventListener('click', () => {
      const hours = parseInt(document.getElementById('batch-hours').value) || 0;
      const minutes = parseInt(document.getElementById('batch-minutes').value) || 0;
      const seconds = parseInt(document.getElementById('batch-seconds').value) || 0;
      const title = document.getElementById('batch-title').value.trim();

      const totalSeconds = hours * 3600 + minutes * 60 + seconds;
      if (totalSeconds <= 0) {
        showToast('Please enter a valid duration');
        return;
      }

      batchState.items.push({
        id: `item-${batchState.nextId++}`,
        title: title || `Video ${batchState.items.length + 1}`,
        hours,
        minutes,
        seconds,
        totalSeconds,
      });

      document.getElementById('batch-title').value = '';
      document.getElementById('batch-hours').value = 0;
      document.getElementById('batch-minutes').value = 0;
      document.getElementById('batch-seconds').value = 0;

      renderBatchList();
      calculateBatch();
    });

    document.getElementById('batch-clear-btn').addEventListener('click', () => {
      batchState.items = [];
      renderBatchList();
      calculateBatch();
    });

    document.getElementById('batch-copy-btn').addEventListener('click', () => {
      const totalOriginal = getBatchOriginalSeconds();
      const totalAdjusted = totalOriginal / batchState.speed;
      const totalTimeSaved = totalOriginal - totalAdjusted;
      const text = `Videos: ${batchState.items.length} | Original: ${formatSeconds(totalOriginal)} | Speed: ${batchState.speed}x | Adjusted: ${formatSeconds(totalAdjusted)} | Time Saved: ${formatSeconds(totalTimeSaved)}`;
      copyToClipboard(text);
    });

    // ============================================
    // MODE SWITCHING
    // ============================================
    const modes = ['standard', 'reverse', 'batch'];
    let currentMode = 'standard';

    function switchMode(mode) {
      currentMode = mode;
      modes.forEach(m => {
        const tab = document.getElementById(`tab-${m}`);
        const panel = document.getElementById(`panel-${m}`);
        if (m === mode) {
          tab.classList.add('active');
          tab.setAttribute('aria-selected', 'true');
          panel.style.display = 'block';
        } else {
          tab.classList.remove('active');
          tab.setAttribute('aria-selected', 'false');
          panel.style.display = 'none';
        }
      });
    }

    document.querySelectorAll('.mode-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        switchMode(tab.dataset.mode);
      });
    });

    // ============================================
    // KEYBOARD SHORTCUTS
    // ============================================
    document.addEventListener('keydown', (e) => {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') {
        return;
      }

      switch (e.key.toLowerCase()) {
        case '1': case '2': case '3': case '4': case '5': case '6': case '7': case '8':
          if (currentMode === 'standard') {
            const speeds = [0.75, 1.25, 1.5, 1.75, 2.0, 2.5, 3.0];
            const idx = parseInt(e.key) - 1;
            if (idx < speeds.length) {
              stdState.speed = speeds[idx];
              document.getElementById('std-speed').value = stdState.speed.toFixed(2);
              document.getElementById('std-speed-slider').value = stdState.speed;
              calculateStd();
            }
          }
          break;
        case 'c':
          if (currentMode === 'standard') document.getElementById('std-copy-btn').click();
          else if (currentMode === 'reverse') document.getElementById('rev-copy-btn').click();
          else if (currentMode === 'batch') document.getElementById('batch-copy-btn').click();
          break;
        case 'r':
          if (currentMode === 'standard') document.getElementById('std-reset-btn').click();
          else if (currentMode === 'reverse') document.getElementById('rev-reset-btn').click();
          else if (currentMode === 'batch') document.getElementById('batch-clear-btn').click();
          break;
        case '?':
          document.getElementById('shortcuts-modal').style.display = 'flex';
          break;
        case 'escape':
          document.getElementById('shortcuts-modal').style.display = 'none';
          break;
      }
    });

    document.getElementById('close-shortcuts').addEventListener('click', () => {
      document.getElementById('shortcuts-modal').style.display = 'none';
    });

    document.getElementById('shortcuts-modal').addEventListener('click', (e) => {
      if (e.target.id === 'shortcuts-modal') {
        document.getElementById('shortcuts-modal').style.display = 'none';
      }
    });

    // ============================================
    // URL PARAMETER PARSING (for shared links)
    // ============================================
    function parseUrlParams() {
      const params = new URLSearchParams(window.location.search);
      const mode = params.get('mode') || 'standard';
      switchMode(mode);

      if (mode === 'standard') {
        const h = parseInt(params.get('h')) || 0;
        const m = parseInt(params.get('m')) || 0;
        const s = parseInt(params.get('s')) || 0;
        const speed = parseFloat(params.get('speed')) || 1.5;
        stdState = { hours: h, minutes: m, seconds: s, speed };
        document.getElementById('std-hours').value = h;
        document.getElementById('std-minutes').value = m;
        document.getElementById('std-seconds').value = s;
        document.getElementById('std-total-time').value = formatSeconds(h * 3600 + m * 60 + s);
        document.getElementById('std-speed').value = speed;
        document.getElementById('std-speed-slider').value = speed;
        calculateStd();
      } else if (mode === 'reverse') {
        const oh = parseInt(params.get('oh')) || 0;
        const om = parseInt(params.get('om')) || 0;
        const os = parseInt(params.get('os')) || 0;
        const th = parseInt(params.get('th')) || 0;
        const tm = parseInt(params.get('tm')) || 0;
        const ts = parseInt(params.get('ts')) || 0;
        revState = { origHours: oh, origMinutes: om, origSeconds: os, targetHours: th, targetMinutes: tm, targetSeconds: ts };
        document.getElementById('rev-orig-hours').value = oh;
        document.getElementById('rev-orig-minutes').value = om;
        document.getElementById('rev-orig-seconds').value = os;
        document.getElementById('rev-total-time').value = formatSeconds(oh * 3600 + om * 60 + os);
        document.getElementById('rev-target-hours').value = th;
        document.getElementById('rev-target-minutes').value = tm;
        document.getElementById('rev-target-seconds').value = ts;
        calculateRev();
      }
    }

    // ============================================
    // CHOOSE FILE - LOCAL VIDEO DURATION AUTO-DETECT
    // ============================================
    (function() {
      var fileInput = document.getElementById('hero-file-input');
      var statusEl = document.getElementById('hero-file-status');
      if (!fileInput || !statusEl) return;

      fileInput.addEventListener('change', function() {
        var file = fileInput.files && fileInput.files[0];
        if (!file) return;
        if (!/^video\//i.test(file.type || '')) {
          statusEl.textContent = 'Please select a video file.';
          statusEl.style.color = 'var(--color-warning-deep)';
          return;
        }

        var url = URL.createObjectURL(file);
        var video = document.createElement('video');
        video.preload = 'metadata';
        video.playsInline = true;
        video.src = url;
        var loaded = false;

        function cleanup() {
          try { URL.revokeObjectURL(url); } catch (e) {}
          video.remove();
          video = null;
        }

        function onLoaded() {
          if (loaded) return;
          loaded = true;
          var seconds = video.duration || 0;
          if (seconds <= 0 || !isFinite(seconds)) {
            statusEl.textContent = 'Could not read duration from ' + file.name + ' — enter time manually below.';
            statusEl.style.color = 'var(--color-warning-deep)';
            cleanup();
            return;
          }
          var h = Math.floor(seconds / 3600);
          var m = Math.floor((seconds % 3600) / 60);
          var s = Math.floor(seconds % 60);
          setStdDuration(h, m, s);
          statusEl.textContent = file.name + ' — ' + formatSeconds(seconds) + ' detected';
          statusEl.style.color = 'var(--color-success-deep)';
          showToast(file.name + ' duration detected (' + formatSeconds(seconds) + ')');
          cleanup();
        }

        video.addEventListener('loadedmetadata', onLoaded);
        video.addEventListener('loadeddata', onLoaded);
        video.addEventListener('canplay', onLoaded);
        video.addEventListener('error', function() {
          if (loaded) return;
          loaded = true;
          statusEl.textContent = 'Could not read ' + file.name + ' — enter time manually below.';
          statusEl.style.color = 'var(--color-warning-deep)';
          cleanup();
        });

        setTimeout(function() {
          if (!loaded) {
            loaded = true;
            var seconds = video.duration || 0;
            if (seconds > 0 && isFinite(seconds)) {
              var h = Math.floor(seconds / 3600);
              var m = Math.floor((seconds % 3600) / 60);
              var s = Math.floor(seconds % 60);
              setStdDuration(h, m, s);
              statusEl.textContent = file.name + ' — ' + formatSeconds(seconds) + ' detected';
              statusEl.style.color = 'var(--color-success-deep)';
              showToast(file.name + ' duration detected (' + formatSeconds(seconds) + ')');
            } else {
              statusEl.textContent = 'Timed out reading ' + file.name + ' — enter time manually below.';
              statusEl.style.color = 'var(--color-warning-deep)';
            }
            cleanup();
          }
        }, 10000);
      });
    })();

    // Initialize
    parseUrlParams();
    calculateStd();
    calculateRev();
    renderBatchList();
    calculateBatch();

    updateStdPresetButtons();
  </script>
</Layout>
