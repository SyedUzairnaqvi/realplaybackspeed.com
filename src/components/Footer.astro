---
export interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---
<footer class={`footer ${className}`} style="margin-top: var(--spacing-2xl);">
  <div class="section-container">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--spacing-xl); margin-bottom: var(--spacing-xl);">
      <div style="display: flex; flex-direction: column; align-items: flex-start; gap: var(--spacing-sm);">
        <a href="/" style="display: flex; align-items: center; gap: var(--spacing-sm); text-decoration: none;">
          <img src="/favicon.ico" alt="Playback speed Calculator logo" width="28" height="28" style="flex-shrink: 0; display: block;" />
          <span style="font-family: var(--font-family-sans); font-weight: 700; font-size: 19px; color: var(--color-ink); letter-spacing: -0.5px;">
            Playback speed Calculator
          </span>
        </a>
        <p style="font-size: var(--font-size-body-sm); color: var(--color-mute); margin: 0;">Free online playback speed calculator. Calculate exact watch time, time saved, and required speed for any media.</p>
      </div>
      <div>
        <div style="font-weight: 600; color: var(--color-ink); margin-bottom: var(--spacing-sm);">Calculators</div>
        <div style="display: flex; flex-direction: column; gap: var(--spacing-xs);">
          <a href="/" style="color: var(--color-body); text-decoration: none; font-size: var(--font-size-body-sm);">Speed Calculator</a>
          <a href="/" style="color: var(--color-body); text-decoration: none; font-size: var(--font-size-body-sm);">Target Time</a>
          <a href="/" style="color: var(--color-body); text-decoration: none; font-size: var(--font-size-body-sm);">Playlist Batch</a>
        </div>
      </div>
      <div>
        <div style="font-weight: 600; color: var(--color-ink); margin-bottom: var(--spacing-sm);">Resources</div>
        <div style="display: flex; flex-direction: column; gap: var(--spacing-xs);">
          <a href="/youtube" style="color: var(--color-body); text-decoration: none; font-size: var(--font-size-body-sm);">YouTube Calculator</a>
          <a href="/video" style="color: var(--color-body); text-decoration: none; font-size: var(--font-size-body-sm);">Video Calculator</a>
          <a href="/audiobook" style="color: var(--color-body); text-decoration: none; font-size: var(--font-size-body-sm);">Audiobook Calculator</a>
          <a href="/podcast" style="color: var(--color-body); text-decoration: none; font-size: var(--font-size-body-sm);">Podcast Calculator</a>
          <a href="/watch-time" style="color: var(--color-body); text-decoration: none; font-size: var(--font-size-body-sm);">Watch Time Calculator</a>
          <a href="/guide" style="color: var(--color-body); text-decoration: none; font-size: var(--font-size-body-sm);">Calculator Guide & FAQ</a>
        </div>
      </div>
      <div>
        <div style="font-weight: 600; color: var(--color-ink); margin-bottom: var(--spacing-sm);">Legal</div>
        <div style="display: flex; flex-direction: column; gap: var(--spacing-xs);">
          <a href="/privacy-policy" style="color: var(--color-body); text-decoration: none; font-size: var(--font-size-body-sm);">Privacy Policy</a>
          <a href="/about" style="color: var(--color-body); text-decoration: none; font-size: var(--font-size-body-sm);">About Us</a>
          <a href="/terms" style="color: var(--color-body); text-decoration: none; font-size: var(--font-size-body-sm);">Terms and Conditions</a>
          <a href="/contact" style="color: var(--color-body); text-decoration: none; font-size: var(--font-size-body-sm);">Contact Us</a>
        </div>
      </div>
    </div>
    <div style="border-top: 1px solid var(--color-hairline); padding-top: var(--spacing-lg); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--spacing-md);">
      <div style="font-size: var(--font-size-body-sm); color: var(--color-mute);">© 2026 Playback speed Calculator. All rights reserved.</div>
      <div style="font-size: var(--font-size-body-sm); color: var(--color-mute);">Built with Astro + Tailwind CSS</div>
    </div>
  </div>
</footer>

<style>
  .footer a {
    transition: color 0.2s ease;
  }
  .footer a:hover {
    color: var(--color-link);
  }
</style>
