---
import { locales, defaultLocale } from '../lib/i18n.js';
import Footer from '../components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
  lang?: string;
  device?: string;
  canonical?: string;
  ogImage?: string;
}

const { title = 'Playback speed Calculator', description = 'Free online playback speed calculator.', lang = defaultLocale, device = 'desktop', canonical, ogImage } = Astro.props;

const siteUrl = 'https://realplaybackspeed.com';
const canonicalUrl = canonical || `${siteUrl}${lang === defaultLocale ? '/' : `/${lang}/`}`;

// Generate hreflang alternates
const hreflangAlternates = Object.keys(locales).map(locale => ({
  lang: locale,
  href: `${siteUrl}${locale === defaultLocale ? '/' : `/${locale}/`}`
}));

// Add x-default
hreflangAlternates.push({ lang: 'x-default', href: `${siteUrl}/` });
---
<!doctype html>
<html lang={lang} data-theme="light" data-device={device} data-lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="PBspeed" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    {hreflangAlternates.map(alt => (
      <link rel="alternate" hreflang={alt.lang} href={alt.href} />
    ))}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafafa" />
    <meta name="robots" content="index, follow" />
    <meta name="keywords" content="playback speed, playback speed calculator, youtube playback speed, spotify playback speed, spotify playback speed extension, playback speed extension, netflix playback speed, audiobook playback speed, video playback speed extension" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage || '/favicon-96x96.png'} />
    <meta property="og:site_name" content="Playback speed Calculator" />
    <meta property="og:locale" content={lang} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage || '/favicon-96x96.png'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (function() {
        var root = document.documentElement;
        try {
          var stored = localStorage.getItem('theme');
          if (stored) {
            root.setAttribute('data-theme', stored);
          } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            root.setAttribute('data-theme', 'dark');
          }
        } catch (e) {}
      })();
    </script>
    <script is:inline src="/i18n.js"></script>
  </head>
  <body>
    <div class="floating-orbs">
      <div class="orb" style="left: 10%; top: 20%; width: 200px; height: 200px; animation-delay: 0s;"></div>
      <div class="orb" style="left: 60%; top: 10%; width: 150px; height: 150px; animation-delay: 2s;"></div>
      <div class="orb" style="left: 30%; top: 70%; width: 180px; height: 180px; animation-delay: 4s;"></div>
      <div class="orb" style="left: 80%; top: 60%; width: 120px; height: 120px; animation-delay: 1s;"></div>
      <div class="orb" style="left: 50%; top: 30%; width: 160px; height: 160px; animation-delay: 3s;"></div>
    </div>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <!-- Sticky navbar -->
    <nav class="nav-bar" style="position: sticky; top: 0; z-index: 50; background: var(--color-canvas-elevated); border-bottom: 1px solid var(--color-hairline); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);">
      <div class="section-container nav-inner" style="display: flex; align-items: center; justify-content: space-between; padding: var(--spacing-sm) var(--spacing-md); flex-wrap: wrap; gap: var(--spacing-md);">
        <a href="/" style="display: flex; align-items: center; gap: var(--spacing-sm); text-decoration: none;">
          <img src="/favicon.ico" alt="Playback speed Calculator logo" width="28" height="28" style="flex-shrink: 0; display: block;" />
          <span style="font-family: var(--font-family-sans); font-weight: 700; font-size: 19px; color: var(--color-ink); letter-spacing: -0.5px;">
            Playback speed Calculator
          </span>
        </a>
        <div style="display: flex; align-items: center; gap: var(--spacing-sm); flex-wrap: wrap;">
          <a href="/" class="btn-primary" style="text-decoration: none;">Open Calculator</a>
          <button class="btn-icon" id="theme-toggle" style="width: 36px; height: 36px;" aria-label="Toggle dark mode">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path class="sun-icon" d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
              <circle class="sun-icon" cx="12" cy="12" r="5" />
              <path class="moon-icon" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
          </button>
        </div>
      </div>
    </nav>

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <script is:inline src="/i18n.js"></script>
    <script is:inline>
      (function() {
        var themeBtn = document.getElementById('theme-toggle');
        var root = document.documentElement;
        var meta = document.querySelector('meta[name="theme-color"]');

        function applyTheme(theme) {
          root.setAttribute('data-theme', theme);
          try { localStorage.setItem('theme', theme); } catch (e) {}
          if (meta) meta.setAttribute('content', theme === 'dark' ? '#0a0a0a' : '#fafafa');
          updateThemeIcons(theme);
        }

        function updateThemeIcons(theme) {
          var suns = document.querySelectorAll('.sun-icon');
          var moons = document.querySelectorAll('.moon-icon');
          suns.forEach(function(el) { el.style.display = theme === 'dark' ? 'none' : 'block'; });
          moons.forEach(function(el) { el.style.display = theme === 'dark' ? 'block' : 'none'; });
        }

        var storedTheme = null;
        try { storedTheme = localStorage.getItem('theme'); } catch (e) {}
        var initialTheme = storedTheme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        applyTheme(initialTheme);

        if (themeBtn) {
          themeBtn.addEventListener('click', function() {
            var current = root.getAttribute('data-theme') || 'light';
            applyTheme(current === 'dark' ? 'light' : 'dark');
          });
        }

        // ---------- Theme persistence across MPA navigation ----------
        function persistTheme() {
          try {
            var t = localStorage.getItem('theme');
            if (t) applyTheme(t);
          } catch (e) {}
        }
        document.addEventListener('astro:after-swap', persistTheme);
        window.addEventListener('pageshow', persistTheme);
        if (document.addEventListener) {
          document.addEventListener('astro:before-swap', function(ev) {
            if (ev && ev.newDocument) {
              ev.newDocument.documentElement.setAttribute('data-theme', root.getAttribute('data-theme') || 'light');
            }
          });
        }

        // ---------- PWA Service Worker ----------
        if ('serviceWorker' in navigator) {
          navigator.serviceWorker.register('/sw.js').then(function(reg) {
            console.log('SW registered', reg.scope);
          }).catch(function(err) {
            console.log('SW registration failed', err);
          });
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
